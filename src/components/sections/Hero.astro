---
import '../../styles/xp/wordart.css';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t[lang].hero;
---

<section id="inicio" class="px-6 py-14 md:px-10 md:py-20">
  <div
    class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[1.15fr_1fr] md:items-center md:gap-12"
  >
    <div>
      <p class="text-[11px] uppercase tracking-[0.3em] text-[#4a4a4a]">
        {copy.eyebrow}
      </p>
      <h1 class="mt-4 text-[42px] leading-none font-bold md:text-[64px]">{copy.name}</h1>
      <p class="mt-5 max-w-xl text-[13px] leading-relaxed text-[#3a3a3a]">
        {copy.paragraph}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#contacto" class="button primary">{copy.primaryCta}</a>
        <a href="#catalogo" class="button">{copy.secondaryCta}</a>
      </div>
    </div>

    <div class="wordart-wrap">
      <span class="wordart">
        <span class="wordart__shade" aria-hidden="true">{copy.wordart}</span>
        <span class="wordart__text">{copy.wordart}</span>
      </span>
    </div>
  </div>
</section>
