---
import '../../styles/xp/wordart.css';
import '../../styles/xp/stamps.css';
import '../../styles/xp/hero.css';
import { t, type Lang } from '../../i18n/ui';
import pareja from '../../assets/stamps/pareja.gif';
import evoluciones from '../../assets/stamps/evoluciones.gif';
import rainbow from '../../assets/stamps/no-rain-no-rainbows.gif';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t[lang].hero;
---

<section id="inicio" class="px-6 py-14 md:px-10 md:py-20">
  <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
    <!-- La marca sigue existiendo para lectores de pantalla y buscadores. -->
    <h1 class="sr-only">{copy.name}</h1>

    <div class="wordart-wrap">
      <span class="wordart">
        <span class="wordart__shade" aria-hidden="true">{copy.wordart}</span>
        <span class="wordart__text">{copy.wordart}</span>
      </span>
    </div>

    <div class="stamps mt-12" aria-hidden="true">
      <img
        src={pareja.src}
        alt=""
        width="193"
        height="127"
        class="stamp--pareja"
        loading="eager"
        decoding="async"
      />
      <img
        src={evoluciones.src}
        alt=""
        width="279"
        height="39"
        class="stamp--evoluciones"
        loading="eager"
        decoding="async"
      />
      <img
        src={rainbow.src}
        alt=""
        width="150"
        height="20"
        class="stamp--rainbow"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="hero-actions mt-20">
      <a href="#contacto" class="button primary">{copy.primaryCta}</a>
      <a href="#catalogo" class="button">{copy.secondaryCta}</a>
    </div>
  </div>
</section>
