---
import '../../styles/xp/wordart.css';

// Texto provisional en estilo kawaii/y2k, como el de la página de referencia.
const wordart = 'holiii!! soy yo :3 ^_^';
---

<section id="inicio" class="px-6 py-14 md:px-10 md:py-20">
  <div
    class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[1.15fr_1fr] md:items-center md:gap-12"
  >
    <div>
      <p class="text-[11px] uppercase tracking-[0.3em] text-[#4a4a4a]">
        Ilustración · Diseño · Arte digital
      </p>
      <h1 class="mt-4 text-[42px] leading-none font-bold md:text-[64px]">Javiera</h1>
      <p class="mt-5 max-w-xl text-[13px] leading-relaxed text-[#3a3a3a]">
        Ilustraciones con carácter, trazos afilados y una paleta que no pasa
        desapercibida. Encargos abiertos para proyectos personales y marcas.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#contacto" class="button primary">Encargar pieza</a>
        <a href="#catalogo" class="button">Ver catálogo</a>
      </div>
    </div>

    <div class="wordart-wrap">
      <span class="wordart">
        <span class="wordart__shade" aria-hidden="true">{wordart}</span>
        <span class="wordart__text">{wordart}</span>
      </span>
    </div>
  </div>
</section>
