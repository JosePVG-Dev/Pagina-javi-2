---
import { Image } from 'astro:assets';
import '../../styles/xp/theme.css';
import '../../styles/xp/precios.css';
import {
  designIds,
  entryPrice,
  finishIds,
  formatsForDesign,
  photos,
  priceFor,
} from '../../data/planes';
import { fill, t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t[lang].pricing;
---

<section id="precios" class="px-4 py-4 md:px-10 md:py-8">
  <div class="xp-group mx-auto max-w-6xl">
    <header class="max-w-2xl">
      <h2 class="text-[22px] leading-tight font-bold md:text-[26px]">{copy.heading}</h2>
      <p class="mt-2 text-[12px] leading-relaxed text-[#4a4a4a]">
        {copy.intro}
      </p>
    </header>

    <hr class="my-6" />

    <div
      class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:items-start"
      data-pricing
    >
      <!-- Matriz de precios: acabados en columnas, formatos en filas. -->
      <div>
        <table class="price-matrix">
          <thead>
            <tr>
              <th scope="col">{copy.tableFormat}</th>
              {finishIds.map((finish) => <th scope="col">{copy.finishes[finish]}</th>)}
            </tr>
          </thead>
          {
            designIds.map((design) => (
              <tbody>
                {design === 'custom' && (
                  <tr class="price-matrix-sub">
                    <th colspan="4" scope="colgroup">
                      <span class="price-matrix-sub-name">{copy.designs[design]}</span>
                      <span class="price-matrix-sub-note">{copy.customNote}</span>
                    </th>
                  </tr>
                )}
                {formatsForDesign(design).map((format) => (
                  <tr>
                    <th scope="row">{copy.formats[format]}</th>
                    {finishIds.map((finish) => (
                      <td class="price-cell">
                        <span class="price-cell-currency">$</span>{priceFor(design, format, finish)}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>

        <p class="price-entry">
          <strong>{copy.entry.name}</strong> — ${entryPrice} · {copy.entry.tag}
        </p>

        <a
          href="#contacto"
          class="button mt-4 block w-full text-[11px] tracking-[0.12em] uppercase"
        >
          {copy.cta}
        </a>

        <p class="price-addons">{copy.addons}</p>
      </div>

      <!-- Galería de ejemplos, independiente de la matriz -->
      <div
        id="precios-carrusel"
        role="region"
        aria-roledescription={copy.carouselRole}
        aria-label={copy.regionLabel}
        data-carousel
      >
        <div class="carousel-viewport" data-viewport>
          <div class="carousel-track" data-track>
            {
              photos.map((photo, i) => (
                <figure
                  class="carousel-slide"
                  data-slide={i}
                  role="group"
                  aria-roledescription={copy.slideRole}
                  aria-label={fill(copy.slideLabel, { n: i + 1, total: photos.length })}
                  aria-hidden={i === 0 ? 'false' : 'true'}
                  inert={i !== 0}
                >
                  <Image
                    src={photo.src}
                    alt={t[lang].photoAlts[photo.id]}
                    widths={[600, 1200]}
                    sizes="(min-width: 1024px) 520px, (min-width: 768px) 620px, 88vw"
                    format="webp"
                    quality={82}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    draggable="false"
                  />
                </figure>
              ))
            }
          </div>

          <span class="carousel-edge" data-progress aria-hidden="true">
            <b data-progress-fill></b>
          </span>
        </div>

        <div class="mt-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
          <div class="flex items-center">
            {
              photos.map((photo, i) => (
                <button
                  type="button"
                  class="carousel-dot"
                  data-dot={i}
                  aria-label={fill(copy.viewPhoto, { name: copy.galleryNames[photo.id] })}
                  aria-current={i === 0 ? 'true' : 'false'}
                />
              ))
            }
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              class="button carousel-arrow carousel-toggle"
              data-playpause
              data-label-pause={copy.pauseAutoplay}
              data-label-play={copy.playAutoplay}
              aria-label={copy.pauseAutoplay}
              title={copy.pauseAutoplay}
              hidden
            >
              ❚❚
            </button>
            <button
              type="button"
              class="button carousel-arrow carousel-arrow--prev"
              data-prev
              aria-label={copy.prev}
            >
              ←
            </button>
            <button
              type="button"
              class="button carousel-arrow carousel-arrow--next"
              data-next
              aria-label={copy.next}
            >
              →
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-pricing]');

  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const viewport = root.querySelector<HTMLElement>('[data-viewport]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const total = slides.length;
    const carousel = root.querySelector<HTMLElement>('#precios-carrusel') ?? root;
    let index = 0;
    let startX = 0;
    let dragging = false;
    let dx = 0;

    /* ---------- avance automático ---------- */
    // 7 s: tiempo medido para leer el plano y pulsar antes del salto (WCAG 2.2.2).
    // Se pausa al pasar el ratón, al enfocar con teclado y fuera de pantalla.
    const AUTOPLAY_MS = 7000;

    const progressFill = root.querySelector<HTMLElement>('[data-progress-fill]');
    const playPause = root.querySelector<HTMLButtonElement>('[data-playpause]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (progressFill) progressFill.style.animationDuration = `${AUTOPLAY_MS}ms`;

    let timer: number | undefined;
    let remaining = AUTOPLAY_MS; // tiempo que le queda al avance en curso
    let deadline = 0;
    let hovering = false;
    let focused = false;
    let onScreen = true;
    let userPaused = false; // decisión explícita del botón ❚❚ / ▶

    const canPlay = () => total > 1 && !reducedMotion.matches;
    const canAutoplay = () => canPlay() && !userPaused;

    const goTo = (next: number) => {
      index = (next + total) % total;

      if (track) track.style.transform = `translateX(-${index * 100}%)`;

      slides.forEach((slide, i) => {
        const active = i === index;
        slide.setAttribute('aria-hidden', String(!active));
        slide.toggleAttribute('inert', !active);
      });

      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => {
      goTo(index - 1);
      pauseOnInteract();
    });
    root.querySelector('[data-next]')?.addEventListener('click', () => {
      goTo(index + 1);
      pauseOnInteract();
    });

    viewport?.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Element && event.target.closest('button')) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;

      startX = event.clientX;
      dx = 0;
      dragging = true;
      pause();
      viewport.setPointerCapture(event.pointerId);
      if (track) track.style.transition = 'none';
    });

    viewport?.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      dx = event.clientX - startX;
      if (track) {
        track.style.transform = `translateX(calc(-${index * 100}% + ${dx}px))`;
      }
    });

    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      if (track) track.style.transition = '';

      if (Math.abs(dx) > 40) {
        goTo(index + (dx < 0 ? 1 : -1));
        pauseOnInteract();
      } else goTo(index);
      dx = 0;
    };

    viewport?.addEventListener('pointerup', endDrag);
    viewport?.addEventListener('pointercancel', endDrag);

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        goTo(i);
        pauseOnInteract();
      })
    );

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        goTo(index - 1);
        pauseOnInteract();
      }
      if (event.key === 'ArrowRight') {
        goTo(index + 1);
        pauseOnInteract();
      }
    });

    /* ---------- avance automático: control ---------- */

    function clearTimer() {
      if (timer !== undefined) {
        window.clearTimeout(timer);
        timer = undefined;
      }
      if (progressFill) progressFill.style.animationPlayState = 'paused';
    }

    /* La barra y el temporizador son dos relojes distintos: cada vez que se
       reprograma el avance, la barra vuelve a empezar para ir sincronizada. */
    function restartProgress() {
      if (!progressFill) return;
      progressFill.style.animationName = 'none';
      void progressFill.offsetWidth; // fuerza el reinicio de la animación
      progressFill.style.animationName = '';
      progressFill.style.animationPlayState = 'running';
    }

    function schedule() {
      clearTimer();
      if (!canAutoplay() || !onScreen || hovering || focused || dragging) return;

      remaining = AUTOPLAY_MS;
      restartProgress();
      deadline = performance.now() + AUTOPLAY_MS;
      timer = window.setTimeout(() => {
        timer = undefined;
        goTo(index + 1);
        schedule();
      }, AUTOPLAY_MS);
    }

    /* Pausa sin perder el punto en el que iba: guarda lo que falta del
       temporizador y congela la barra. Al reanudar, ambos siguen desde ahí. */
    function pause() {
      if (timer !== undefined) {
        remaining = Math.max(0, deadline - performance.now());
      }
      clearTimer();
    }

    /* Reanuda desde `remaining`, sin reiniciar la barra ni el conteo. */
    function resume() {
      if (timer !== undefined) return;
      if (!canAutoplay() || !onScreen || hovering || focused || dragging) return;

      const wait = Math.max(0, remaining);

      deadline = performance.now() + wait;
      if (progressFill) progressFill.style.animationPlayState = 'running';
      timer = window.setTimeout(() => {
        timer = undefined;
        goTo(index + 1);
        schedule();
      }, wait);
    }

    /* Navegación manual: el avance se detiene y queda a cargo del botón ▶.
       Si no, el carrusel arrastra la vista a mitad de la exploración. */
    function pauseOnInteract() {
      remaining = AUTOPLAY_MS;
      if (!canPlay()) return;
      userPaused = true;
      pause();
      syncToggle();
    }

    /* Refleja el estado en el botón y oculta la barra cuando no hay avance. */
    function syncToggle() {
      const playing = !userPaused;

      carousel.toggleAttribute('data-autoplay-off', !canPlay() || userPaused);
      if (!playPause) return;

      const label = playing ? playPause.dataset.labelPause : playPause.dataset.labelPlay;
      playPause.hidden = !canPlay();
      playPause.textContent = playing ? '❚❚' : '▶';
      if (label) {
        playPause.setAttribute('aria-label', label);
        playPause.title = label;
      }
    }

    playPause?.addEventListener('click', () => {
      userPaused = !userPaused;
      if (userPaused) pause();
      else schedule();
      syncToggle();
    });

    /* El avance se detiene solo cuando el puntero está sobre la foto. Si el
       cursor se queda en las flechas o los puntos, el carrusel sigue vivo. */
    viewport?.addEventListener('pointerenter', () => {
      hovering = true;
      pause();
    });

    viewport?.addEventListener('pointerleave', () => {
      hovering = false;
      resume();
    });

    /* Solo el foco de teclado frena el avance: el que deja un clic con el
       ratón no debe congelarlo. El propio botón de avance no cuenta: si lo
       enfocas para reanudar, el carrusel debe moverse. */
    carousel.addEventListener('focusin', (event) => {
      if (playPause && event.target === playPause) return;
      focused = !(event.target instanceof Element) || event.target.matches(':focus-visible');
      if (focused) pause();
      else resume();
    });

    carousel.addEventListener('focusout', () => {
      focused = false;
      resume();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pause();
      else resume();
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          onScreen = entries.some((entry) => entry.isIntersecting);
          if (onScreen) resume();
          else pause();
        },
        { threshold: 0.15 }
      ).observe(carousel);
    }

    reducedMotion.addEventListener('change', () => {
      syncToggle();
      schedule();
    });

    /* Con movimiento reducido o una sola foto no hay nada que pausar. */
    syncToggle();

    goTo(index);
    schedule();
  }
</script>
