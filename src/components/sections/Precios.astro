---
import { Image } from 'astro:assets';
import '../../styles/xp/theme.css';
import '../../styles/xp/precios.css';
import { plans, photos, entryPrice, featuredPlanIndex, featuredSlideIndex } from '../../data/planes';
import { fill, t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t[lang].pricing;
const plansCopy = t[lang].plans;
const featuredPlanName = plansCopy[plans[featuredPlanIndex].id].name;

// Nombre para el aria-label de cada punto: la entrada y el plan a cotizar no
// viven en `plans`, así que se resuelven con su copia propia.
const slideNames: Record<string, string> = {
  icon: copy.entry.name,
  chibi: plansCopy.chibi.name,
  bust: plansCopy.bust.name,
  mega: plansCopy.mega.name,
  custom: copy.custom.name,
};
---

<section id="precios" class="px-6 py-6 md:px-10 md:py-8">
  <div class="xp-group mx-auto max-w-6xl">
    <header class="max-w-2xl">
      <h2 class="text-[26px] leading-tight font-bold">{copy.heading}</h2>
      <p class="mt-2 text-[12px] leading-relaxed text-[#4a4a4a]">
        {copy.intro}
      </p>
    </header>

    <hr class="my-6" />

    <div
      class="grid grid-cols-1 gap-6 md:grid-cols-[2fr_3fr] md:items-start"
      data-pricing
      data-plan-template={copy.choosePlan}
      data-start-index={featuredSlideIndex}
    >
      <!-- 40%: precios -->
      <div>
        <ul class="list price-list">
          <!-- Puerta de entrada: primer renglón, fuera de la escalera. -->
          <li>
            <button
              type="button"
              class="price-row price-row--entry"
              data-price-row={0}
              aria-controls="precios-carrusel"
              aria-current={featuredSlideIndex === 0 ? 'true' : 'false'}
            >
              <span>
                <span class="price-row-name" data-plan-name>{copy.entry.name}</span>
                <span class="price-row-tag">{copy.entry.tag}</span>
              </span>
              <span class="price-row-amount">
                <span>$</span>{entryPrice}
              </span>
            </button>
          </li>

          {
            plans.map((plan, i) => (
              <li>
                <button
                  type="button"
                  class="price-row"
                  data-price-row={i + 1}
                  aria-controls="precios-carrusel"
                  aria-current={i + 1 === featuredSlideIndex ? 'true' : 'false'}
                >
                  <span>
                    <span class="price-row-name" data-plan-name>
                      {plansCopy[plan.id].name}
                    </span>
                    <span class="price-row-tag">{plansCopy[plan.id].tag}</span>
                  </span>
                  <span class="price-row-amount">
                    <span>$</span>{plan.price}
                  </span>
                </button>
              </li>
            ))
          }

          <!-- Plan a cotizar: cierra la lista, sin precio propio. -->
          <li>
            <button
              type="button"
              class="price-row price-row--custom"
              data-price-row={photos.length - 1}
              aria-controls="precios-carrusel"
              aria-current={photos.length - 1 === featuredSlideIndex ? 'true' : 'false'}
            >
              <span>
                <span class="price-row-name" data-plan-name>{copy.custom.name}</span>
                <span class="price-row-tag">{copy.custom.body}</span>
              </span>
              <span class="price-row-amount price-row-amount--text">
                {copy.custom.amount}
              </span>
            </button>
          </li>
        </ul>

        <a
          href="#contacto"
          class="button mt-4 block w-full text-[11px] tracking-[0.12em] uppercase"
          data-cta
        >
          {fill(copy.choosePlan, { name: featuredPlanName })}
        </a>

        <p class="price-addons">{copy.addons}</p>
      </div>

      <!-- 60%: carrusel -->
      <div
        id="precios-carrusel"
        role="region"
        aria-roledescription={copy.carouselRole}
        aria-label={copy.regionLabel}
        data-carousel
      >
        <div class="carousel-viewport" data-viewport>
          <div class="carousel-track" data-track>
            {
              photos.map((photo, i) => (
                <figure
                  class="carousel-slide"
                  data-slide={i}
                  role="group"
                  aria-roledescription={copy.slideRole}
                  aria-label={fill(copy.slideLabel, { n: i + 1, total: photos.length })}
                  aria-hidden={i === featuredSlideIndex ? 'false' : 'true'}
                  inert={i !== featuredSlideIndex}
                >
                  <Image
                    src={photo.src}
                    alt={t[lang].photoAlts[photo.id]}
                    widths={[600, 1200]}
                    sizes="(min-width: 768px) 600px, 90vw"
                    format="webp"
                    quality={82}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    draggable="false"
                  />
                </figure>
              ))
            }
          </div>

          <span class="carousel-edge" data-progress aria-hidden="true">
            <b data-progress-fill></b>
          </span>
        </div>

        <div class="mt-3 flex items-center justify-between gap-4">
          <div class="flex items-center">
            {
              photos.map((photo, i) => (
                <button
                  type="button"
                  class="carousel-dot"
                  data-dot={i}
                  aria-label={fill(copy.viewPhoto, { name: slideNames[photo.id] })}
                  aria-current={i === featuredSlideIndex ? 'true' : 'false'}
                />
              ))
            }
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              class="button carousel-arrow carousel-toggle"
              data-autoplay-toggle
              aria-label={copy.pauseAutoplay}
              data-pause-label={copy.pauseAutoplay}
              data-play-label={copy.playAutoplay}
            >
              <span aria-hidden="true" data-autoplay-icon>❚❚</span>
            </button>
            <button
              type="button"
              class="button carousel-arrow carousel-arrow--prev"
              data-prev
              aria-label={copy.prev}
            >
              ←
            </button>
            <button
              type="button"
              class="button carousel-arrow carousel-arrow--next"
              data-next
              aria-label={copy.next}
            >
              →
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-pricing]');

  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const viewport = root.querySelector<HTMLElement>('[data-viewport]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-price-row]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const cta = root.querySelector<HTMLElement>('[data-cta]');
    const ctaTemplate = root.dataset.planTemplate ?? '{name}';
    const names = rows.map(
      (row) => row.querySelector('[data-plan-name]')?.textContent?.trim() ?? ''
    );
    const total = slides.length;
    const carousel = root.querySelector<HTMLElement>('#precios-carrusel') ?? root;
    let index = Number(root.dataset.startIndex ?? '0') || 0; // arranca en el peldaño destacado
    let startX = 0;
    let dragging = false;
    let dx = 0;

    /* ---------- avance automático ---------- */
    const AUTOPLAY_MS = 3000;
    const AUTOPLAY_KEY = 'javi:carousel-autoplay';

    const toggle = root.querySelector<HTMLButtonElement>('[data-autoplay-toggle]');
    const toggleIcon = root.querySelector<HTMLElement>('[data-autoplay-icon]');
    const progress = root.querySelector<HTMLElement>('[data-progress]');
    const progressFill = root.querySelector<HTMLElement>('[data-progress-fill]');
    const pauseLabel = toggle?.dataset.pauseLabel ?? '';
    const playLabel = toggle?.dataset.playLabel ?? '';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (progressFill) progressFill.style.animationDuration = `${AUTOPLAY_MS}ms`;

    let timer: number | undefined;
    let hovering = false;
    let focused = false;
    let onScreen = true;
    let stopped = false; // el visitante navegó a mano: no vuelve a arrancar
    let optedOut = false; // el visitante pulsó pausa: se recuerda entre visitas

    try {
      optedOut = window.localStorage.getItem(AUTOPLAY_KEY) === 'off';
    } catch {
      /* almacenamiento bloqueado: seguimos con el valor por defecto */
    }

    const canAutoplay = () => total > 1 && !reducedMotion.matches && !stopped && !optedOut;

    const goTo = (next: number) => {
      index = (next + total) % total;

      if (track) track.style.transform = `translateX(-${index * 100}%)`;

      slides.forEach((slide, i) => {
        const active = i === index;
        slide.setAttribute('aria-hidden', String(!active));
        slide.toggleAttribute('inert', !active);
      });

      rows.forEach((row, i) => row.setAttribute('aria-current', String(i === index)));
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));

      if (cta && names[index]) cta.textContent = ctaTemplate.replace('{name}', names[index]);
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => {
      stopAutoplay();
      goTo(index - 1);
    });
    root.querySelector('[data-next]')?.addEventListener('click', () => {
      stopAutoplay();
      goTo(index + 1);
    });

    viewport?.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Element && event.target.closest('button')) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;

      startX = event.clientX;
      dx = 0;
      dragging = true;
      clearTimer();
      viewport.setPointerCapture(event.pointerId);
      if (track) track.style.transition = 'none';
    });

    viewport?.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      dx = event.clientX - startX;
      if (track) {
        track.style.transform = `translateX(calc(-${index * 100}% + ${dx}px))`;
      }
    });

    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      if (track) track.style.transition = '';

      if (Math.abs(dx) > 40) {
        stopAutoplay();
        goTo(index + (dx < 0 ? 1 : -1));
      } else goTo(index);
      dx = 0;
    };

    viewport?.addEventListener('pointerup', endDrag);
    viewport?.addEventListener('pointercancel', endDrag);

    rows.forEach((row, i) =>
      row.addEventListener('click', () => {
        stopAutoplay();
        goTo(i);
      })
    );
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        stopAutoplay();
        goTo(i);
      })
    );

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        stopAutoplay();
        goTo(index - 1);
      }
      if (event.key === 'ArrowRight') {
        stopAutoplay();
        goTo(index + 1);
      }
    });

    /* ---------- avance automático: control ---------- */

    function clearTimer() {
      if (timer !== undefined) {
        window.clearTimeout(timer);
        timer = undefined;
      }
      if (progressFill) progressFill.style.animationPlayState = 'paused';
    }

    /* La barra y el temporizador son dos relojes distintos: cada vez que se
       reprograma el avance, la barra vuelve a empezar para ir sincronizada. */
    function restartProgress() {
      if (!progressFill) return;
      progressFill.style.animationName = 'none';
      void progressFill.offsetWidth; // fuerza el reinicio de la animación
      progressFill.style.animationName = '';
      progressFill.style.animationPlayState = 'running';
    }

    function syncToggle() {
      if (!toggle) return;
      const playing = canAutoplay();
      toggle.setAttribute('aria-label', playing ? pauseLabel : playLabel);
      if (toggleIcon) toggleIcon.textContent = playing ? '❚❚' : '▶';
      progress?.toggleAttribute('data-idle', !playing);
    }

    function schedule() {
      clearTimer();
      if (!canAutoplay() || !onScreen || hovering || focused || dragging) return;

      restartProgress();
      timer = window.setTimeout(() => {
        timer = undefined;
        goTo(index + 1);
        schedule();
      }, AUTOPLAY_MS);
    }

    function stopAutoplay() {
      if (stopped) return;
      stopped = true;
      clearTimer();
      syncToggle();
    }

    toggle?.addEventListener('click', () => {
      const playing = canAutoplay();

      if (playing) {
        optedOut = true;
      } else {
        optedOut = false;
        stopped = false;
      }

      try {
        window.localStorage.setItem(AUTOPLAY_KEY, optedOut ? 'off' : 'on');
      } catch {
        /* almacenamiento bloqueado: la elección solo dura esta visita */
      }

      syncToggle();
      if (optedOut) clearTimer();
      else schedule();
    });

    carousel.addEventListener('pointerenter', () => {
      hovering = true;
      clearTimer();
    });

    carousel.addEventListener('pointerleave', () => {
      hovering = false;
      schedule();
    });

    carousel.addEventListener('focusin', () => {
      focused = true;
      clearTimer();
    });

    carousel.addEventListener('focusout', () => {
      focused = false;
      schedule();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) clearTimer();
      else schedule();
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          onScreen = entries.some((entry) => entry.isIntersecting);
          if (onScreen) schedule();
          else clearTimer();
        },
        { threshold: 0.15 }
      ).observe(carousel);
    }

    reducedMotion.addEventListener('change', () => {
      syncToggle();
      schedule();
    });

    /* Con movimiento reducido o una sola foto no hay nada que pausar. */
    root.toggleAttribute('data-autoplay-off', reducedMotion.matches || total < 2);

    syncToggle();
    goTo(index);
    schedule();
  }
</script>
