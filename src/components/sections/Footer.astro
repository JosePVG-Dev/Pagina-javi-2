---
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t[lang].footer;
---

<footer class="bottom-panel">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-1 text-[11px]">
    <span>© {new Date().getFullYear()} Bloomysrkj</span>
    <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <span>{copy.tagline}</span>
      <span aria-hidden="true" class="opacity-70">|</span>
      <a
        href="https://josepvg.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-credit"
      >
        {copy.credit}
      </a>
    </span>
  </div>
</footer>
