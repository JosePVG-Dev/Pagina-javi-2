---
import { Image } from 'astro:assets';
import { catalog } from '../../data/planes';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t[lang].catalog;
const items = t[lang].catalogItems;
---

<section id="catalogo" class="px-4 py-4 md:px-10 md:py-8">
  <div class="xp-group mx-auto max-w-6xl">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-[20px] font-bold md:text-[22px]">{copy.heading}</h2>
      <a href="#contacto" class="button">{copy.cta}</a>
    </div>

    <hr class="my-5" />

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-5">
      {
        catalog.map((item, i) => (
          <article class="raised p-1.5 sm:p-2">
            <div class="aspect-[4/3] w-full overflow-hidden border border-[#7f9db9] bg-[#f7f5ec]">
              <Image
                src={item.src}
                alt={items[item.id].alt}
                widths={[220, 440]}
                sizes="(min-width: 1024px) 210px, (min-width: 640px) 30vw, 45vw"
                format="webp"
                quality={80}
                loading={i < 5 ? 'eager' : 'lazy'}
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
            <p class="mt-2 px-1 pb-1 text-[9px] uppercase tracking-[0.15em] text-[#4a4a4a] sm:text-[10px]">{items[item.id].type}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
