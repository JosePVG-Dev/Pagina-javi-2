---
import { catalog } from '../../data/planes';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t[lang].catalog;
const items = t[lang].catalogItems;
---

<section id="catalogo" class="px-6 py-6 md:px-10 md:py-8">
  <div class="xp-group mx-auto max-w-6xl">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-[22px] font-bold">{copy.heading}</h2>
      <a href="#contacto" class="button">{copy.cta}</a>
    </div>

    <hr class="my-5" />

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        catalog.map((id) => (
          <article class="raised p-2">
            <div
              class="aspect-[4/3] w-full border border-[#7f9db9] [background-image:var(--media-gradient)]"
              aria-hidden="true"
            />
            <div class="mt-2 flex items-baseline justify-between gap-3 px-1 pb-1">
              <h3 class="text-[12px] font-bold">{items[id].title}</h3>
              <span class="text-[10px] uppercase tracking-[0.15em] text-[#4a4a4a]">{items[id].type}</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
