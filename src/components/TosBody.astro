---
import '../styles/xp/theme.css';
import '../styles/xp/layout.css';
import { routes, t, type Lang } from '../i18n/ui';
import Nav from './sections/Nav.astro';
import Footer from './sections/Footer.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t[lang].tos;
const home = routes[lang];
---

<div class="xp-section flex min-h-screen flex-col bg-[var(--window-bg)]">
  <Nav lang={lang} page="tos" />

  <main class="flex-1 px-4 py-5 md:px-10 md:py-8">
    <article class="tos-copy xp-group mx-auto max-w-3xl">
      <header>
        <h1 class="text-[22px] leading-tight font-bold md:text-[28px]">{copy.heading}</h1>
        <p class="mt-1.5 text-[11px] text-[#4a4a4a]">{copy.updated}</p>
        <p class="mt-4 text-[12px] leading-relaxed md:text-[13px]">{copy.intro}</p>
      </header>

      <div class="tos-summary mt-5">
        <p class="text-[11px] font-bold tracking-[0.08em] uppercase">{copy.summary.heading}</p>
        <ul class="mt-1.5">
          {copy.summary.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <hr class="my-5" />

      <nav aria-label={copy.index} class="tos-index">
        <ul>
          {
            copy.sections.map((section, i) => (
              <li>
                <a href={`#tos-${i + 1}`}>{section.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        copy.sections.map((section, i) => (
          <section id={`tos-${i + 1}`} class="tos-section">
            <h2 class="text-[14px] font-bold md:text-[16px]">{section.title}</h2>

            {section.body && <p class="mt-1.5">{section.body}</p>}

            {section.items && (
              <ul class="mt-1.5">
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}

            {section.links && (
              <ul class="tos-links mt-2">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.href.startsWith('http') ? '_blank' : undefined}
                      rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }

      <p class="tos-acceptance">{copy.acceptance}</p>

      <p class="mt-4">
        <a class="tos-back" href={home}>← {copy.back}</a>
      </p>
    </article>
  </main>

  <Footer lang={lang} />
</div>

<style>
  .tos-copy {
    font-size: 12px;
    line-height: 1.6;
  }

  .tos-copy :global(ul) {
    list-style: disc;
    padding-left: 1.15rem;
  }

  .tos-copy :global(li + li) {
    margin-top: 0.3rem;
  }

  .tos-summary {
    border: 1px solid #d0d0bf;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.55);
    padding: 0.55rem 0.75rem;
  }

  .tos-summary :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tos-index :global(ul) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    padding-left: 0;
    font-size: 11px;
  }

  .tos-index :global(li) {
    margin: 0;
  }

  .tos-index :global(a) {
    text-decoration: underline;
    text-decoration-color: #a9a99a;
    text-underline-offset: 2px;
  }

  .tos-index :global(a:hover),
  .tos-links :global(a:hover),
  .tos-back:hover {
    background: rgba(49, 106, 197, 0.12);
  }

  .tos-section {
    margin-top: 1.1rem;
    scroll-margin-top: 104px;
  }

  .tos-links :global(a),
  .tos-back {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tos-acceptance {
    margin-top: 1.5rem;
    border-top: 1px solid #d0d0bf;
    padding-top: 0.65rem;
    font-size: 11px;
    font-weight: bold;
  }

  @media (min-width: 768px) {
    .tos-copy {
      font-size: 13px;
    }

    .tos-section {
      margin-top: 1.35rem;
      scroll-margin-top: 64px;
    }
  }
</style>
