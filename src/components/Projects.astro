---
const projects = [
  {
    title: 'Landing de producto',
    description: 'Pagina de conversion enfocada en performance y copy claro.',
    stack: 'Astro, Tailwind, Motion',
    href: '#'
  },
  {
    title: 'Dashboard operativo',
    description: 'UI modular con estados y filtros para datos de negocio.',
    stack: 'React, TypeScript, Charts',
    href: '#'
  },
  {
    title: 'Sitio editorial',
    description: 'Blog orientado a SEO tecnico y carga rapida en movil.',
    stack: 'Astro, MDX, RSS',
    href: '#'
  }
];
---

<section id="proyectos" class="mx-auto max-w-5xl px-6 py-14">
  <div class="mb-8 flex items-end justify-between gap-4">
    <h2 class="text-2xl font-semibold">Proyectos destacados</h2>
    <a href="#" class="text-sm font-medium text-[var(--accent)] hover:underline">Ver todos</a>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    {
      projects.map((project) => (
        <article class="rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-5 transition hover:-translate-y-1 hover:border-[var(--accent)]/30">
          <h3 class="text-lg font-semibold">{project.title}</h3>
          <p class="mt-2 text-sm text-[var(--muted)]">{project.description}</p>
          <p class="mt-4 text-xs tracking-wide text-[var(--muted)] uppercase">{project.stack}</p>
          <a href={project.href} class="mt-5 inline-block text-sm font-medium text-[var(--accent)] hover:underline">
            Ver caso
          </a>
        </article>
      ))
    }
  </div>
</section>
