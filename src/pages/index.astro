---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/xp/layout.css';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Precios from '../components/sections/Precios.astro';
import Catalogo from '../components/sections/Catalogo.astro';
import Contacto from '../components/sections/Contacto.astro';
import Footer from '../components/sections/Footer.astro';
---

<BaseLayout title="Javiera | Portfolio" description="Ilustración y diseño por Javiera.">
  <div class="xp-section bg-[var(--window-bg)]">
    <Nav />
    <Hero />
    <Precios />
    <Catalogo />
    <Contacto />
    <Footer />
  </div>
</BaseLayout>
